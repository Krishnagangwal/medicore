PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/medicore_backend
JWT_SECRET=min-32-chars-same-as-gateway
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_GATEWAY_URL=http://localhost:8000
NODE_ENV=development
# Comma-separated — one entry per deployed portal. Not needed in local dev
# (each portal's Vite dev server proxies /api same-origin, see its
# vite.config.js), but required in production since the backend (Render) and
# each portal (Vercel) are then on different domains.
# e.g. CORS_ORIGIN=https://medicore-app.vercel.app,https://medicore-nurse.vercel.app,https://medicore-doctor.vercel.app
CORS_ORIGIN=

# Transactional email via Resend (resend.com) — raw SMTP (Gmail etc.) is
# unreliable from hosts like Render that block outbound SMTP ports.
# Sign up, grab an API key from resend.com/api-keys.
RESEND_API_KEY=
# Optional — defaults to Resend's shared sandbox sender, which can only
# deliver to the email your Resend account itself signed up with. Verify a
# domain at resend.com/domains and put an address on it here to actually
# email real hospital admins/staff.
RESEND_FROM_EMAIL=
# Used for links in emails (approval/invite/reset-password) — point this at
# the deployed `app` portal specifically, since that's the one with the
# /reset-password route and the unified login.
FRONTEND_URL=http://localhost:3000
